  "angleGrammar": {
    "azimuths": [
      {
        "id": "front",
        "deg": 0,
        "token": "front view"
      },
      {
        "id": "front-right",
        "deg": 45,
        "token": "front-right quarter view"
      },
      {
        "id": "right",
        "deg": 90,
        "token": "right side view"
      },
      {
        "id": "back-right",
        "deg": 135,
        "token": "back-right quarter view"
      },
      {
        "id": "back",
        "deg": 180,
        "token": "back view"
      },
      {
        "id": "back-left",
        "deg": 225,
        "token": "back-left quarter view"
      },
      {
        "id": "left",
        "deg": 270,
        "token": "left side view"
      },
      {
        "id": "front-left",
        "deg": 315,
        "token": "front-left quarter view"
      }
    ],
    "elevations": [
      {
        "id": "low",
        "deg": -30,
        "token": "low-angle shot"
      },
      {
        "id": "eye",
        "deg": 0,
        "token": "eye-level shot"
      },
      {
        "id": "elevated",
        "deg": 30,
        "token": "elevated shot"
      },
      {
        "id": "high",
        "deg": 60,
        "token": "high-angle shot"
      }
    ],
    "distances": [
      {
        "id": "close",
        "scale": 0.6,
        "token": "close-up"
      },
      {
        "id": "medium",
        "scale": 1.0,
        "token": "medium shot"
      },
      {
        "id": "wide",
        "scale": 1.8,
        "token": "wide shot"
      }
    ],
    "template": "<sks> {azimuth} {elevation} {distance}",
    "example": "<sks> front-right quarter view eye-level shot medium shot",
    "snap": "Snap continuous rig values to the nearest token: azimuth sector = round(deg/45) mod 8 (deg clockwise from front, subject's right = 90); elevation buckets <-15 low, <15 eye, <45 elevated, else high (same as core CameraAngle node); distance by scale."
  },
  "reshootGrammar": {
    "azimuths": [
      "far to the left",
      "to the left",
      "slightly to the left",
      "same angle",
      "slightly to the right",
      "to the right",
      "far to the right"
    ],
    "elevations": [
      "lower",
      "same height",
      "higher"
    ],
    "distances": [
      "closer",
      "same distance",
      "further"
    ],
    "template": "crossview. new camera angle: {azimuth}, {elevation}, {distance}."
  },
  "cameraMoves": [
    {
      "id": "static",
      "label": "Static",
      "lora": "ltx-2-19b-lora-camera-control-static.safetensors",
      "prompt": "The camera is locked off on a tripod and does not move."
    },
    {
      "id": "dolly-in",
      "label": "Dolly In",
      "lora": "ltx-2-19b-lora-camera-control-dolly-in.safetensors",
      "prompt": "The camera dollies in toward the subject, ending on a close-up."
    },
    {
      "id": "dolly-out",
      "label": "Dolly Out",
      "lora": "ltx-2-19b-lora-camera-control-dolly-out.safetensors",
      "prompt": "The camera dollies back away from the subject, ending on a wide shot that reveals the surroundings."
    },
    {
      "id": "dolly-zoom",
      "label": "Dolly Zoom",
      "lora": null,
      "prompt": "Vertigo dolly zoom: the camera pushes in while the lens zooms out, the subject stays the same size as the background warps."
    },
    {
      "id": "dolly-left",
      "label": "Truck Left",
      "lora": "ltx-2-19b-lora-camera-control-dolly-left.safetensors",
      "prompt": "The camera tracks sideways to the left, ending with the subject on the right of frame."
    },
    {
      "id": "dolly-right",
      "label": "Truck Right",
      "lora": "ltx-2-19b-lora-camera-control-dolly-right.safetensors",
      "prompt": "The camera tracks sideways to the right, ending with the subject on the left of frame."
    },
    {
      "id": "jib-up",
      "label": "Jib Up",
      "lora": "ltx-2-19b-lora-camera-control-jib-up.safetensors",
      "prompt": "The camera cranes up, rising above the subject and ending on a high-angle view."
    },
    {
      "id": "jib-down",
      "label": "Jib Down",
      "lora": "ltx-2-19b-lora-camera-control-jib-down.safetensors",
      "prompt": "The camera cranes down, descending to end at a low angle looking up at the subject."
    },
    {
      "id": "orbit-left",
      "label": "Orbit Left",
      "lora": null,
      "prompt": "The camera orbits around the subject to the left in a smooth arc, ending on the subject's profile."
    },
    {
      "id": "orbit-right",
      "label": "Orbit Right",
      "lora": null,
      "prompt": "The camera orbits around the subject to the right in a smooth arc, ending on the subject's profile."
    },
    {
      "id": "pan-left",
      "label": "Pan Left",
      "lora": null,
      "prompt": "The camera pans left from a fixed position."
    },
    {
      "id": "pan-right",
      "label": "Pan Right",
      "lora": null,
      "prompt": "The camera pans right from a fixed position."
    },
    {
      "id": "tilt-up",
      "label": "Tilt Up",
      "lora": null,
      "prompt": "The camera tilts up from a fixed position, revealing what is above."
    },
    {
      "id": "tilt-down",
      "label": "Tilt Down",
      "lora": null,
      "prompt": "The camera tilts down from a fixed position."
    },
    {
      "id": "handheld",
      "label": "Handheld",
      "lora": null,
      "prompt": "Handheld camera with subtle natural shake, following the subject."
    }
  ]
}
